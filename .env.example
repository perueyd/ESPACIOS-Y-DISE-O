# Copia este archivo como `.env` y completa los valores. `.env` NUNCA se sube a GitHub.
# Usa valores DISTINTOS para pruebas y para producción.

# Base de datos de trabajo (Supabase o Neon), PostgreSQL 15 o superior.
DATABASE_URL=

# Certificado de la base (Supabase: Project Settings → Database → SSL → Download certificate).
# Pega el contenido completo (-----BEGIN CERTIFICATE----- ...). Con él la conexión va cifrada y
# verificada. Si lo usas, NO pongas "sslmode" en DATABASE_URL.
DATABASE_CA_CERT=

# Base SOLO para pruebas automáticas (se borra en cada corrida; el nombre debe terminar en _pruebas).
# Se obtiene con: npm run db:prueba
DATABASE_URL_PRUEBAS=

# Llave maestra para cifrar certificados y claves (32 bytes en base64).
# Se genera con: npm run llave:generar   — guárdala también en un gestor de contraseñas:
# si se pierde, hay que volver a cargar los certificados.
LLAVE_MAESTRA=

# Algoritmo de firma: SHA1 (por defecto) o SHA256. SUNAT beta aceptó ambos (23-oct-2026);
# se recomienda SHA256 para producción.
FIRMA_ALGORITMO=SHA1

# SOLO desarrollo: carpeta local para XML firmados y constancias. Vacío = se guardan en la
# base de datos (lo correcto en producción: los respaldos de la base los incluyen).
ALMACEN_DIR=

# Doble candado para enviar a SUNAT PRODUCCIÓN. Solo con autorización del dueño.
# Déjalo vacío hasta entonces.
SUNAT_PERMITIR_PRODUCCION=

# API: puerto del servidor y clave del cron (POST /v1/cola/procesar). Genera la clave con:
#   npm run llave:generar
PUERTO=3000
CLAVE_CRON=
