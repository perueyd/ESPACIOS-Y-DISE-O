# Copia este archivo como `.env` y completa los valores. `.env` NUNCA se sube a GitHub.
# Usa valores DISTINTOS para pruebas y para producción.

# Base de datos de trabajo (Supabase o Neon), PostgreSQL 15 o superior.
DATABASE_URL=

# Base SOLO para pruebas automáticas (se borra en cada corrida; el nombre debe terminar en _pruebas).
# Se obtiene con: npm run db:prueba
DATABASE_URL_PRUEBAS=

# Llave maestra para cifrar certificados y claves (32 bytes en base64).
# Se genera con: npm run llave:generar   — guárdala también en un gestor de contraseñas:
# si se pierde, hay que volver a cargar los certificados.
LLAVE_MAESTRA=

# Algoritmo de firma: SHA1 (por defecto, el que usa Greenter) o SHA256 (por confirmar en SUNAT beta).
FIRMA_ALGORITMO=SHA1
