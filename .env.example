# Copia este archivo como `.env` y completa los valores. `.env` NUNCA se sube a GitHub.

# Base de datos de trabajo (Supabase o Neon). Ambientes de pruebas y producción con bases distintas.
DATABASE_URL=

# Base SOLO para pruebas automáticas (se borra en cada corrida; el nombre debe terminar en _pruebas).
# Se obtiene con: npm run db:prueba
DATABASE_URL_PRUEBAS=

# --- Fases siguientes (aún no se usan) ---
# Llave maestra para cifrar certificados y credenciales SOL (32 bytes en base64).
# LLAVE_MAESTRA=
